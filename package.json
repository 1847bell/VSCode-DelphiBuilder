{
  "name": "delphi-dcc-builder",
  "displayName": "Delphi DCC Builder",
  "description": "Build Delphi Win32 and Win64 projects with DCC32 and DCC64 from Visual Studio Code.",
  "version": "0.2.10",
  "icon": "images/icon.png",
  "publisher": "1847bell",
  "author": "Alex Niu",
  "repository": {
    "type": "git",
    "url": "https://github.com/1847bell/VSCode-DelphiBuilder.git"
  },
  "bugs": {
    "url": "https://github.com/1847bell/VSCode-DelphiBuilder/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "delphi",
    "dcc32",
    "dcc64",
    "xe7"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:delphiDccProjects",
    "onCommand:delphiDcc.createGroup",
    "onCommand:delphiDcc.addProjects",
    "onCommand:delphiDcc.activateConfiguration",
    "onCommand:delphiXe7.buildProject",
    "onCommand:delphiXe7.buildProjectWin64",
    "onCommand:delphiXe7.rebuildProject",
    "onCommand:delphiXe7.cancelBuild",
    "onCommand:delphiXe7.showBuildPlan",
    "onCommand:delphiXe7.changeOutputPath"
  ],
  "contributes": {
    "commands": [
      {
        "command": "delphiDcc.createGroup",
        "title": "Delphi DCC Builder: New Group",
        "icon": "$(new-folder)"
      },
      {
        "command": "delphiDcc.sortGroups",
        "title": "Delphi DCC Builder: Sort Groups",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "delphiDcc.refreshProjects",
        "title": "Delphi DCC Builder: Refresh Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "delphiDcc.renameGroup",
        "title": "Delphi DCC Builder: Rename Group"
      },
      {
        "command": "delphiDcc.moveGroupUp",
        "title": "Delphi DCC Builder: Move Group Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "delphiDcc.moveGroupDown",
        "title": "Delphi DCC Builder: Move Group Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "delphiDcc.addProjects",
        "title": "Delphi DCC Builder: Add Dproj Projects",
        "icon": "$(file-add)"
      },
      {
        "command": "delphiDcc.activateConfiguration",
        "title": "Delphi DCC Builder: Activate Configuration"
      },
      {
        "command": "delphiDcc.showOutputPaths",
        "title": "Delphi DCC Builder: Show Current Output Paths"
      },
      {
        "command": "delphiXe7.buildProject",
        "title": "Delphi DCC Builder: Build for Win32",
        "icon": "$(tools)"
      },
      {
        "command": "delphiXe7.buildProjectWin64",
        "title": "Delphi DCC Builder: Build for Win64",
        "icon": "$(tools)"
      },
      {
        "command": "delphiXe7.rebuildProject",
        "title": "Delphi DCC Builder: Rebuild for Win32",
        "icon": "$(sync)"
      },
      {
        "command": "delphiXe7.cancelBuild",
        "title": "Delphi DCC Builder: Cancel Build",
        "icon": "$(debug-stop)"
      },
      {
        "command": "delphiXe7.showBuildPlan",
        "title": "Delphi DCC Builder: Show Build Plan",
        "icon": "$(list-tree)"
      },
      {
        "command": "delphiXe7.changeOutputPath",
        "title": "Delphi DCC Builder: Change Output Path",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "delphiDcc.createGroup",
          "when": "view == delphiDccProjects",
          "group": "navigation@1"
        },
        {
          "command": "delphiDcc.sortGroups",
          "when": "view == delphiDccProjects",
          "group": "navigation@2"
        },
        {
          "command": "delphiDcc.refreshProjects",
          "when": "view == delphiDccProjects",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "delphiDcc.addProjects",
          "when": "view == delphiDccProjects && viewItem == delphiProjectGroup",
          "group": "inline@1"
        },
        {
          "command": "delphiDcc.renameGroup",
          "when": "view == delphiDccProjects && viewItem == delphiProjectGroup",
          "group": "navigation@1"
        },
        {
          "command": "delphiDcc.moveGroupUp",
          "when": "view == delphiDccProjects && viewItem == delphiProjectGroup",
          "group": "navigation@2"
        },
        {
          "command": "delphiDcc.moveGroupDown",
          "when": "view == delphiDccProjects && viewItem == delphiProjectGroup",
          "group": "navigation@3"
        },
        {
          "command": "delphiDcc.showOutputPaths",
          "when": "view == delphiDccProjects && viewItem == delphiGroupedProject",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "delphiXe7.buildProject",
          "when": "resourceExtname == .dproj",
          "group": "navigation@10"
        },
        {
          "command": "delphiXe7.buildProjectWin64",
          "when": "resourceExtname == .dproj && config.delphiXe7.compiler64Path",
          "group": "navigation@11"
        },
        {
          "command": "delphiXe7.changeOutputPath",
          "when": "resourceExtname == .dproj",
          "group": "navigation@12"
        },
        {
          "command": "delphiXe7.showBuildPlan",
          "when": "resourceExtname == .dproj && config.delphiXe7.showBuildPlanMenu == show",
          "group": "navigation@13"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "delphiDcc",
          "title": "Delphi Projects",
          "icon": "images/activitybar.svg"
        }
      ]
    },
    "views": {
      "delphiDcc": [
        {
          "id": "delphiDccProjects",
          "name": "Projects",
          "contextualTitle": "Delphi Projects",
          "visibility": "visible"
        }
      ]
    },
    "configuration": {
      "title": "Delphi DCC Builder",
      "properties": {
        "delphiDcc.version": {
          "type": "string",
          "enum": [
            "XE7"
          ],
          "enumItemLabels": [
            "Delphi XE7"
          ],
          "default": "XE7",
          "scope": "resource",
          "description": "Delphi compiler version used to resolve version-specific build settings and BDS environment values."
        },
        "delphiDcc.resourceBuild": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Prepare missing project resources and compile .dproj RcCompile resources before running DCC."
        },
        "delphiXe7.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Required absolute path to the Delphi XE7 DCC32.exe. Builds fail when this setting is empty."
        },
        "delphiXe7.compiler64Path": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional absolute path to the Delphi XE7 DCC64.exe. The Win64 Explorer build command is shown when this setting is not empty."
        },
        "delphiXe7.rsvarsPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional absolute path to rsvars.bat. Leave empty to discover it from the configured compiler or BDS installation."
        },
        "delphiXe7.brcc32Path": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional absolute path to BRCC32.exe used to compile RcCompile resources. Leave empty to discover it from the Delphi installation or PATH."
        },
        "delphiXe7.showBuildPlanMenu": {
          "type": "string",
          "enum": [
            "hide",
            "show"
          ],
          "enumItemLabels": [
            "Hide",
            "Show"
          ],
          "default": "hide",
          "scope": "resource",
          "description": "Show or hide the Show Build Plan command in the .dproj Explorer context menu."
        },
        "delphiXe7.outputPathHistoryLimit": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 15,
          "scope": "resource",
          "description": "Maximum number of output path history entries stored for each .dproj project."
        },
        "delphiXe7.outputEncoding": {
          "type": "string",
          "enum": [
            "system",
            "cp936",
            "utf8"
          ],
          "default": "system",
          "scope": "resource",
          "description": "Encoding used to decode DCC32 or DCC64 output."
        },
        "delphiXe7.additionalArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Additional DCC arguments appended before the main source file."
        },
        "delphiXe7.environment": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables applied to DCC32 or DCC64 after the selected Delphi version's registry environment."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:xe7": "vitest run --config vitest.integration.config.ts",
    "package": "npm run check && npm run test && npm run compile && vsce package --no-dependencies"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
